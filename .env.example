# ClubCore — variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# .env está en .gitignore y NUNCA se commitea.

# ── Base de datos (MySQL) ──────────────────────────────────────
DB_USERNAME=clubcore_user
DB_PASSWORD=cambiar_en_produccion
DB_ROOT_PASSWORD=root_cambiar_en_produccion

# Solo para producción (Railway/Render provee esta variable):
# DB_URL=jdbc:mysql://<host>:3306/clubcore_db?useSSL=true&serverTimezone=UTC

# ── JWT ────────────────────────────────────────────────────────
# String Base64 de al menos 32 bytes para HS256.
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_por_un_secreto_base64_de_64_bytes_como_minimo

# Expiración del token en milisegundos (default: 86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# ── Integraciones async ────────────────────────────────────────
# URL del webhook de n8n (o cualquier receptor) para notificaciones de vencimiento.
# Dejar vacío para deshabilitar el disparo (no lanza error).
# Ejemplo de prueba: https://webhook.site/<tu-uuid>
N8N_WEBHOOK_URL=

# ── Spring Boot ────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
