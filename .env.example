# ClubCore — variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# .env está en .gitignore y NUNCA se commitea.

# ── Base de datos (MySQL) ──────────────────────────────────────
DB_USERNAME=clubcore_user
DB_PASSWORD=cambiar_en_produccion
DB_ROOT_PASSWORD=root_cambiar_en_produccion

# Solo para el perfil `prod` (con docker compose no hace falta: el compose ya apunta a su MySQL):
# DB_URL=jdbc:mysql://<host>:3306/clubcore_db?useSSL=true&serverTimezone=UTC

# ── JWT ────────────────────────────────────────────────────────
# String Base64 de al menos 32 bytes para HS256.
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_por_un_secreto_base64_de_64_bytes_como_minimo

# Expiración del token en milisegundos (default: 86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# ── Integraciones async ────────────────────────────────────────
# URL del webhook de n8n (o cualquier receptor) para notificaciones de vencimiento.
# Dejar vacío para deshabilitar el disparo (no lanza error).
# Ejemplo de prueba: https://webhook.site/<tu-uuid>
N8N_WEBHOOK_URL=

# ── Webhook inbound de pagos ────────────────────────────────────
# Secreto compartido con el gateway de pago (o quien simule su rol) para verificar la
# firma HMAC-SHA256 de POST /api/v1/webhooks/pagos (header X-Webhook-Signature).
# Sin este valor, el endpoint rechaza TODAS las requests con 401 (fail-closed).
# Generar con: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=CAMBIAR_por_un_secreto_compartido_con_el_gateway

# ── CORS ──────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma (ej: https://app.clubcore.com,https://admin.clubcore.com).
# Obligatorio en perfil 'prod' (falla al arrancar si falta). En dev/test, si se deja vacío,
# cae a '*' con un warning en el log.
CORS_ALLOWED_ORIGINS=

# ── Spring Boot ────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
